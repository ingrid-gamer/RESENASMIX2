{
  "info": {
    "name": "RESENASMIX2 API",
    "description": "Colección de pruebas de integración para backend Spring Boot. Configura baseUrl y ejecuta primero el login para obtener el JWT.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8083"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "videojuegoId",
      "value": "1"
    },
    {
      "key": "usuarioId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "01 - Registrar usuario (ajustar datos únicos)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"usuario_prueba\",\n  \"password\": \"ClaveSegura123\",\n  \"nombre\": \"Usuario Prueba\",\n  \"email\": \"prueba@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "02 - Iniciar sesión y guardar JWT",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"usuario_prueba\",\n  \"password\": \"ClaveSegura123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.collectionVariables.set(\"token\", data.token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Listar videojuegos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/videojuegos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "videojuegos"
          ]
        }
      },
      "response": []
    },
    {
      "name": "04 - Obtener videojuego por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/videojuegos/{{videojuegoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "videojuegos",
            "{{videojuegoId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "05 - Listar reseñas",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/resenas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "resenas"
          ]
        }
      },
      "response": []
    },
    {
      "name": "06 - Crear reseña (el autor se toma del JWT)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/resenas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "resenas"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"videojuegoId\": 1,\n  \"calificacion\": 5,\n  \"comentario\": \"Reseña de prueba de integración.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "07 - Consultar juegos gratuitos externos",
